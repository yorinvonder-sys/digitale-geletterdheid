# Claude Code (shared settings, project docs, and canonical skills are tracked)
.claude/*
!.claude/*.md
!.claude/settings.json
!.claude/commands/
!.claude/commands/**
!.claude/skills/
!.claude/skills/**
!.claude/agents/
!.claude/agents/**
!.claude/team/
!.claude/team/**

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files (NEVER commit these!)
.env
.env.local
.env.production
functions/.env
users.json
uids_to_delete.txt
serviceAccountKey.json
**/serviceAccountKey.json
firebase-service-account.json
**/firebase-service-account.json
migration-report.json
supabase/.temp/
supabase/.branches/
.mcp.json

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Lighthouse reports (contain captured API keys in network traces)
lighthouse-reports/
lighthouse-report.json

# Agent/browser artifacts (large and noisy for LLM context)
.agent/skills/
.claude/worktrees/
.playwright-mcp/
playwright-report/
test-results/
screenshots/
!public/screenshots/
!public/screenshots/**
.tmp-context/
tmp/
.superpowers/
public/dev-docs/

# Firebase (legacy - migrated to Supabase)
.firebase/

# Large archives
*.zip

# Canonical tracked specs store — feature folders under specs/ are the planning
# source of truth and must never be hidden by the broad rules above.
# Re-include browser-evidence console logs that the generic *.log rule above
# would otherwise exclude from the tracked store.
!specs/**/*.log
