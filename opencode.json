{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-sol",
  "default_agent": "dg-orchestrator",
  "subagent_depth": 1,
  "share": "disabled",
  "instructions": [
    "AGENTS.md"
  ],
  "enabled_providers": [
    "openai",
    "deepseek"
  ],
  "provider": {
    "deepseek": {
      "whitelist": [
        "deepseek-v4-flash"
      ]
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "code-review": {
      "disable": true
    },
    "docs-writer": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "dg-orchestrator": {
      "tools": {
        "linear_*": true,
        "supabase_list_tables": true,
        "supabase_list_extensions": true,
        "supabase_list_migrations": true,
        "supabase_search_docs": true,
        "vercel_search_vercel_documentation": true,
        "vercel_list_teams": true,
        "vercel_list_projects": true,
        "vercel_get_project": true,
        "vercel_list_deployments": true,
        "vercel_get_deployment": true
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
      "oauth": {}
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=tdaylulsnbhhjuufmdzk&read_only=true&features=database,docs",
      "enabled": true,
      "oauth": {}
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true,
      "oauth": {}
    }
  },
  "tools": {
    "linear_*": false,
    "supabase_*": false,
    "vercel_*": false
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.aws/**": "deny",
      "~/.ssh/**": "deny",
      "~/.config/**": "deny",
      "~/.claude/**": "deny",
      "~/.local/share/opencode/**": "deny",
      "~/Library/Keychains/**": "deny"
    },
    "bash": {
      "*": "deny",
      "git reset --hard*": "deny",
      "git checkout --*": "deny",
      "git clean -*": "deny",
      "git push --force*": "deny",
      "git merge*": "deny",
      "git pull*": "deny",
      "git rebase*": "deny",
      "gh pr merge*": "deny",
      "gh api*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "env*": "deny",
      "printenv*": "deny",
      "security*": "deny",
      "psql*": "deny",
      "vercel*": "deny",
      "npx vercel*": "deny",
      "supabase*": "deny",
      "npx supabase*": "deny"
    }
  }
}
