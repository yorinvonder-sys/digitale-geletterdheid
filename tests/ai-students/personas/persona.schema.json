{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgskills.app/schemas/ai-student-persona-v1.json",
  "title": "DGSkills AI-studentpersona",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "age",
    "readingLevel",
    "digitalSkill",
    "deviceProfile",
    "readingBehavior",
    "decisionBehavior",
    "errorBehavior",
    "helpBehavior",
    "testGoals",
    "preferredViewports",
    "behaviorWeights",
    "seedSalt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 2 },
    "age": { "type": "integer", "minimum": 10, "maximum": 18 },
    "readingLevel": { "enum": ["low", "a2-b1", "average", "high"] },
    "digitalSkill": { "enum": ["low", "average", "high"] },
    "deviceProfile": { "enum": ["desktop", "tablet", "mixed"] },
    "readingBehavior": { "$ref": "#/$defs/nonEmptyStrings" },
    "decisionBehavior": { "$ref": "#/$defs/nonEmptyStrings" },
    "errorBehavior": { "$ref": "#/$defs/nonEmptyStrings" },
    "helpBehavior": { "$ref": "#/$defs/nonEmptyStrings" },
    "testGoals": { "$ref": "#/$defs/nonEmptyStrings" },
    "preferredViewports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["desktop", "ipad-portrait", "ipad-landscape", "mobile"] }
    },
    "behaviorWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readingCoverage",
        "decisionSpeed",
        "uncertainty",
        "errorRate",
        "hintUsage",
        "backtrackRate",
        "shortcutSeeking",
        "manipulationAttempt",
        "touchReliance"
      ],
      "properties": {
        "readingCoverage": { "$ref": "#/$defs/weight" },
        "decisionSpeed": { "$ref": "#/$defs/weight" },
        "uncertainty": { "$ref": "#/$defs/weight" },
        "errorRate": { "$ref": "#/$defs/weight" },
        "hintUsage": { "$ref": "#/$defs/weight" },
        "backtrackRate": { "$ref": "#/$defs/weight" },
        "shortcutSeeking": { "$ref": "#/$defs/weight" },
        "manipulationAttempt": { "$ref": "#/$defs/weight" },
        "touchReliance": { "$ref": "#/$defs/weight" }
      }
    },
    "seedSalt": { "type": "string", "minLength": 3 }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "weight": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
