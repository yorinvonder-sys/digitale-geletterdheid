{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgskills.app/schemas/ai-student-report-v1.json",
  "title": "DGSkills AI-student testrapport",
  "type": "object",
  "required": ["schemaVersion", "run", "summary", "personaReports"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "run": { "type": "object" },
    "summary": { "type": "object" },
    "personaReports": {
      "type": "array",
      "items": { "$ref": "#/$defs/personaReport" }
    }
  },
  "$defs": {
    "personaReport": {
      "type": "object",
      "required": ["personaId", "displayName", "results", "issues"],
      "properties": {
        "personaId": { "type": "string" },
        "displayName": { "type": "string" },
        "results": { "type": "array" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission",
        "persona",
        "pageOrStep",
        "category",
        "severity",
        "description",
        "expectedBehavior",
        "actualBehavior",
        "learnerImpact",
        "reproductionSteps",
        "evidenceReferences",
        "recommendedFix",
        "confidence",
        "evidenceType",
        "requiresHumanValidation",
        "pedagogicalImpact"
      ],
      "properties": {
        "mission": { "type": "string" },
        "persona": { "type": "string" },
        "pageOrStep": { "type": "string" },
        "category": { "enum": ["TECHNICAL", "USABILITY", "LANGUAGE", "DIDACTICS", "RESILIENCE"] },
        "severity": { "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "OBSERVATION"] },
        "description": { "type": "string" },
        "expectedBehavior": { "type": "string" },
        "actualBehavior": { "type": "string" },
        "learnerImpact": { "type": "string" },
        "reproductionSteps": { "type": "array", "items": { "type": "string" } },
        "evidenceReferences": { "type": "array", "items": { "type": "string" } },
        "recommendedFix": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceType": { "enum": ["OBJECTIVE", "SIMULATION", "INFERENCE"] },
        "requiresHumanValidation": { "type": "boolean" },
        "pedagogicalImpact": { "type": "boolean" }
      }
    }
  }
}
